# ==============================================================================
# CampusSave — Mobile Flutter Configuration Example
# ==============================================================================

# URL de l'API REST backend
# Note émulateur Android officiel : http://10.0.2.2:4000/api/v1
# Note smartphone physique sur le réseau local : http://192.168.X.X:4000/api/v1
API_BASE_URL=http://10.0.2.2:4000/api/v1

# Style cartographique MapLibre OpenFreeMap
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Mode démonstration (true / false)
USE_MOCKS=false
