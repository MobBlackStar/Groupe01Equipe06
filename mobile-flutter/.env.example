# ==============================================================================
# CampusSave — Mobile Flutter Configuration Example
# ==============================================================================

# URL de l'API REST backend (hébergé). Émulateur Android : http://10.0.2.2:4000/api/v1
API_BASE_URL=https://<hote-du-backend>/api/v1

# URL du site web hébergé (ex. GitHub Pages) : affiche le radar 3D WebGL dans l'application.
# Laisser vide pour n'utiliser que la carte 2D native.
WEB_APP_URL=https://<utilisateur>.github.io/<depot>

# Style cartographique MapLibre OpenFreeMap
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Mode démonstration (true / false)
USE_MOCKS=false
