# ==============================================================================
# CampusSave — Web React Environment Configuration Example
# ==============================================================================

# Backend API
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Firebase Client Configuration (Web App)
VITE_FIREBASE_API_KEY=AIzaSyExampleApiKeyForCampusSaveWeb
VITE_FIREBASE_AUTH_DOMAIN=campussave-essect-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=campussave-essect-dev
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_VAPID_KEY=BExampleVapidKeyForWebPushNotifications

# Cartographie Vectorielle & Radar 3D (OpenFreeMap)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Mode Démonstration / Mocks (true | false)
VITE_USE_MOCKS=false
