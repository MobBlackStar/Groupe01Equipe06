# ==============================================================================
# CampusSave — Backend Node.js Configuration Example
# ==============================================================================

# Environnement & Serveur
NODE_ENV=development
# Jetons de démo (test-token:/mock-token:/demo-) : actifs hors production. En PRODUCTION ils sont refusés,
# sauf démo jury déployée : mettre ALLOW_DEMO_TOKENS=true (jamais sur une vraie base d'utilisateurs).
# ALLOW_DEMO_TOKENS=false
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173
# En production : ajouter l'origine du site hébergé, ex. https://<utilisateur>.github.io (sans chemin)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=campussave-essect-dev
# Clé de compte de service JSON encodée en base64 (une seule ligne)
FIREBASE_SERVICE_ACCOUNT_BASE64=eyJuYW1lIjoiZXhhbXBsZSJ9

# Passerelle de Paiement Konnect (Sandbox)
KONNECT_API_BASE=https://api.sandbox.konnect.network/api/v2
KONNECT_API_KEY=your-konnect-sandbox-api-key
KONNECT_RECEIVER_WALLET_ID=your-konnect-wallet-id
KONNECT_PAYMENT_LIFESPAN_MIN=10

# Cryptographie & Sécurité Ticket Dynamique
# Clé secrète de 64 caractères hexadécimaux pour dérivation HMAC-SHA256
QR_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
QR_WINDOW_SECONDS=30
RESERVATION_HOLD_MINUTES=10

# Intelligence Artificielle (Pré-remplissage d'offres via Google Gemini Flash)
AI_PROVIDER=gemini
AI_MODEL=gemini-3-flash-preview
GEMINI_API_KEY=<your_google_ai_studio_key>
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_TIMEOUT_MS=12000

# Hébergement d'Images Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
